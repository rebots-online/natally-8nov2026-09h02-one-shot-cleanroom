  end

  subgraph Stage["App stage (AppShell)"]
    SHELL --> FL["onboarding/FirstLight (welcome → intake → casting)"]
    SHELL --> INSET["stage/Inset (dock/float/resize card)"]
    SHELL --> CHATP["chat/ChatPanel + useChat"]
    SHELL --> KAR["karaokeCaption (word-glow captions)"]
    SHELL --> TOPUP["TopUpSheet"]
    SHELL --> SOUV["souvenir/SouvenirDialog (lazy)"]
