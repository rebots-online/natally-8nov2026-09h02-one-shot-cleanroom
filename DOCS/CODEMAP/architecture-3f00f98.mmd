    PRE["services/supertonicTts.ts<br/>getPreloadedVoice / preload seam"]
    STON["atelier-original/services/supertonicTts.ts<br/>(worker, WASM/graph runtime)"]
    PRE --> VI
    VI --> STON
  end

  SHELL --> PRE
  FL --> PRE
  PB -->|word boundaries| VI

