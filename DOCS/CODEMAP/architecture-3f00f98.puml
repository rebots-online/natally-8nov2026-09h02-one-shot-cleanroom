  [chart/AstroChart.tsx + scene.ts\ncanvas wheel (souvenir)] as C2D
  [chart/liveReading.ts\nauthored lesson + today's sky] as LR
}

package "Voice" {
  [voice/index.ts createVoice()\nsentence-buffered, gesture-gated] as VOICE
  [services/supertonicTts.ts preload seam] as SEAM
  [atelier-original/services/supertonic*.ts\nworker TTS runtime] as TTS
}

package "Server (Netlify)" {
  [functions/chargebee.mjs\n/billing/{access,checkout,redeem,\nwebhook,history,invoices/:id,chat}] as FN
  [billing/verify.mts\nFirebase ID token verify] as VER
  [billing/ledger.mjs\nFirestore REST ledger] as LED
  [billing/chargebee.mjs\nChargebee REST client] as CBC
  [billing/openrouter.mjs\nmanaged keys + chat] as ORR
  [functions/ephemeris.mjs\nsigned swisseph positions/houses] as EPH
  [billing/server.mjs\nlocal dev host of the router] as DEV
}

cloud "Upstreams" {
  [Chargebee] as CB
  [Firestore] as FS
  [OpenRouter\nfree-tier chain] as OR
