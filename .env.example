# Public keys only; secrets resolve at runtime from KStore pointers.

VITE_BILLING_API_URL=https://natally-hosted-chat.netlify.app
VITE_CHARGEBEE_SITE=kstore://admin-manual/CREDENTIALS/Chargebee/Natally/credentials.env#VITE_CHARGEBEE_SITE
VITE_FIREBASE_CONFIG=kstore://admin-manual/CREDENTIALS/Natally/firebase-web.env#VITE_FIREBASE_CONFIG
VITE_CREDIT_DISPLAY_PER_USD=100

# Server-side (runtime-resolved, documentation only):
# CHARGEBEE_SITE / CHARGEBEE_API_KEY / CHARGEBEE_WEBHOOK_SECRET
# OPENROUTER_ADMIN_KEY, OPENROUTER_BASE_URL
# FIREBASE_SERVICE_ACCOUNT_JSON, BILLING_KEY_ENCRYPTION_KEY, BILLING_ALLOWED_ORIGIN
# BILLING_OFFER_PRICE_USD=30.00, BILLING_CREDIT_PACKS_USD=5,10,25
# BILLING_REDEMPTION_CODE, BILLING_REDEMPTION_ALLOWANCE_USD=10.00

# --- verbatim landing port (src/landing-original) public build values,
# mirroring the original deployment's .env.example ---
