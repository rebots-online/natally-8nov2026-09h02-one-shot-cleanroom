    AH["app.html"]
    LH --> LM["src/landing/main.tsx<br/>plants version meta"]
    AH --> ME["src/main.tsx (entry dispatcher)"]
    LM -->|dynamic import| MKT["src/landing-original/marketing.tsx<br/>(verbatim port v1.42, self-mounts)"]
