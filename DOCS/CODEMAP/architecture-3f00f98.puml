}

package "Browser · app surface (src/main.tsx dispatch)" {
  [AppShell.tsx\nApp: stage, header, account] as SHELL
  [onboarding/FirstLight\nwelcome→intake→casting] as FL
  [intake/BirthForm] as BF
  [stage/Inset.tsx\ndock/float/resize card] as INSET
  [chat/ChatPanel + useChat] as CHAT
  [chat/inference.ts\nSSE client /billing/chat] as INFC
  [presentation/*\ncues → playback → state] as PRES
  [karaokeCaption] as KAR
  [TopUpSheet + commerce/*] as COM
  [souvenir/* (lazy)\nreport→pdf→retain] as SOUV
}

package "Astrology" {
  [astro/chart.ts natalChart()\nclean-room pipeline] as AC
  [astro/ephemeris.ts\nswisseph WASM wrapper] as AE
  [astro/gazetteer.ts + gazetteer.json\n(108 places)] as GZ
