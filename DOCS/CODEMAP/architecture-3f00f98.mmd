  end

  FL -->|onSitDown NatalChart| SHELL
  MKT --> INSET

  subgraph Pres["Presentation pipeline"]
    OPEN["presentation/opening.ts<br/>openingReading(chart)"] -->|cued text| PB["presentation/playback.ts<br/>PlaybackDriver"]
    CHATP -->|streamed reply| CUES["presentation/cues.ts<br/>parseReply"]
    CUES --> PB
    PB -->|applies Cue actions| ST["presentation/state.ts<br/>presentationReducer"]
    ST -->|focus/view| SHELL
  end

  subgraph Astro["Astrology engines"]
    AC["astro/chart.ts natalChart()<br/>(clean-room, swisseph WASM)"]
    AE["astro/ephemeris.ts<br/>(julianDay, calcUt, placidusHouses)"]
    GZ["astro/gazetteer.ts<br/>(searchPlace, resolvePlace)"]
